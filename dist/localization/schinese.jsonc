		"augment_eager": "渴望",
		"augment_eager_desc": "在每次试炼或无尽挑战开始时，提升一级",
		"augment_gambler": "赌徒",
		"augment_gambler_desc": "每次使用重抽机会后，主武器伤害+20%，持续20秒。",
		"augment_haze": "迷雾",
		"augment_haze_desc": "如果你的生命值低于50%，全局射速+50%。",
		"augment_immaculate": "纯洁",
		"augment_immaculate_desc": "每次完美输入会提升+1.5%暴击率。",
		"augment_devotion": "奉献",
		"augment_devotion_desc": "每有一个空武器槽位，主武器伤害+25%。",
		"augment_armada": "舰队",
		"augment_armada_desc": "每次生成一架无人机时，有20%概率额外生成一架。",
		"augment_diversity": "多样性",
		"augment_diversity_desc": "当装配非无人机类型武器时，所有无人机的持续时间提升20%。",
		"augment_blitzkrieg": "闪电战",
		"augment_blitzkrieg_desc": "无人机速度的提升同样会作用于无人机的伤害。",
		"augment_retribution": "报应",
		"augment_retribution_desc": "当一面护盾被击破时，所有现存的无人机会自毁，对敌人造成爆炸伤害。",
		"augment_scapegoat": "替罪羊",
		"augment_scapegoat_desc": "拼写错误会随机摧毁一架无人机，不再被视作错误。",
		"augment_spoils": "溺爱",
		"augment_spoils_desc": "无人机消失时会掉落拾取道具。",
		"augment_fortress": "堡垒",
		"augment_fortress_desc": "每次炮塔进化会让主武器的最大生命值+50。",
		"augment_networked": "互联",
		"augment_networked_desc": "其他每座炮塔会使所有炮塔射速+10%，最多提升至+50%。",
		"augment_fieldIntel": "战场情报",
		"augment_fieldIntel_desc": "激活一个拾取道具会使所有现存炮塔攻击范围+30%，该效果不可叠加。",
		"augment_darkRelay": "暗黑传递",
		"augment_darkRelay_desc": "生成一个会在现存炮塔之间随机弹跳的投掷物，该投掷物会造成电击伤害。",
		"augment_observer": "观察者",
		"augment_observer_desc": "如果在3秒内你没有发动任何攻击，直至你的下一次攻击前，炮塔伤害+30%。",
		"augment_observer_powerup": "{1}炮塔伤害",
		"augment_weakness": "弱点",
		"augment_weakness_desc": "炮塔射程内的敌人受到其他来源的伤害时，所受伤害提高30%。",
		"augment_corrosion": "腐蚀",
		"augment_corrosion_desc": "持续伤害可以暴击。",
		"augment_lamprey": "七鳃鳗",
		"augment_lamprey_desc": "在主武器附近造成的持续伤害会回复主武器1点生命值。",
		"augment_tenacity": "强韧",
		"augment_tenacity_desc": "所有持续伤害类武器的持续时间提升35%。",
		"augment_afflictors": "苦痛者集群",
		"augment_afflictors_desc": "将苦痛者加入至战利品池。每个苦痛者+3%持续伤害，在主武器附近时该效果翻倍。",
		"augment_conviction": "信念",
		"augment_conviction_desc": "如果你的重抽次数保持在最大值，持续伤害类武器的射速+40%。",
		"augment_conviction_powerup": "{1}持续伤害类武器射速",
		"augment_infector": "感染者",
		"augment_infector_desc": "持续伤害类武器施加状态效果的概率+3%。",
		"augment_closeCombat": "近身搏斗",
		"augment_closeCombat_desc": "所有远程伤害被视为发生在主武器附近。",
		"augment_caltrops": "三角钉",
		"augment_caltrops_desc": "在远程武器暴击时，生成12个三角钉，对通过的敌人造成伤害。",
		"augment_causticAmmo": "腐蚀性弹药",
		"augment_causticAmmo_desc": "有概率获得腐蚀弹药。接下来的20秒内，所有远程武器的基础伤害额外附加10点化学伤害。",
		"augment_piracy": "劫掠",
		"augment_piracy_desc": "每装备一件战利品武器，所有远程伤害提升15%。",
		"augment_deliverance": "拯救",
		"augment_deliverance_desc": "如果你的护盾面数保持在最大值，远程武器的攻击范围+40%。",
		"augment_deliverance_powerup": "{1}远程武器攻击范围",
		"augment_sniper": "狙击手",
		"augment_sniper_desc": "远程武器攻击范围的提升同样会作用于远程武器的伤害。",
