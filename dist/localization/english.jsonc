		"augment_scapegoat_desc": "Mistypes randomly destroy an existing Drone rather than counting as a mistype.",
		"augment_spoils": "Spoils",
		"augment_spoils_desc": "Drones can drop pickups on expiry.",

		// Turrets.
		"augment_fortress": "Fortress",
		"augment_fortress_desc": "Every Turret Evolution also grants +50 Main Weapon max health.",
		"augment_networked": "Networked",
		"augment_networked_desc": "Each other Turret grants +10% Rate of Fire to all Turrets, up to a maximum of +50%.",
		"augment_fieldIntel": "Field Intel",
		"augment_fieldIntel_desc": "Activating a pickup grants +30% Range to all existing Turrets. This effect does not stack.",
		"augment_darkRelay": "Dark Relay",
		"augment_darkRelay_desc": "A projectile bounces between existing Turrets randomly, dealing electrical damage.",
		"augment_observer": "Observer",
		"augment_observer_desc": "If you've not attacked for 3 seconds, gain +30% Turret Damage until your next attack.",
		"augment_observer_powerup": "{1} Turret Damage",
		"augment_weakness": "Weakness",
		"augment_weakness_desc": "Enemies within a Turret's Range take 30% more damage from other sources.",

		// D.O.T.
		"augment_corrosion": "Corrosion",
		"augment_corrosion_desc": "D.O.T. Damage can now crit.",
		"augment_lamprey": "Lamprey",
		"augment_lamprey_desc": "D.O.T. Damage dealt close to Main Weapon heals the Main Weapon by 1 Health.",
		"augment_tenacity": "Tenacity",
		"augment_tenacity_desc": "Increase duration of all D.O.T. weapons by 35%.",
		"augment_afflictors": "Afflictors",
		"augment_afflictors_desc": "Add Afflictors to Loot pool. Each gives +4% D.O.T. Damage. Double effect near Main Weapon.",
		"augment_conviction": "Conviction",
		"augment_conviction_desc": "D.O.T. weapons get +40% Rate of Fire as long as you have max Re-rolls.",
		"augment_conviction_powerup": "{1} D.O.T. Rate of Fire",
		"augment_infector": "Infector",
		"augment_infector_desc": "D.O.T. weapons have +3% status effect chance.",
		
		// Remote.
		"augment_closeCombat": "Close Combat",
    	"augment_closeCombat_desc": "All Remote Damage is considered close to Main Weapon.",
		"augment_caltrops": "Caltrops",
		"augment_caltrops_desc": "On a critical hit by remote weapons, spawn 12 Caltrops that damage passing enemies.",
		"augment_causticAmmo": "Caustic Ammo",
		"augment_causticAmmo_desc": "Chance to drop Caustic Ammo - adds 10 base Chemical Damage to Remote Weapons for 20 seconds.",
		"augment_piracy": "Piracy",
		"augment_piracy_desc": "For every Loot Weapon equipped, increase all Remote Damage by 15%.",
		"augment_deliverance": "Deliverance",
		"augment_deliverance_desc": "All Remote weapons get +40% Range as long as you have max Shields.",
		"augment_deliverance_powerup": "{1} Remote Range",
		"augment_sniper": "Sniper",
		"augment_sniper_desc": "Remote Range upgrades also apply to Remote Damage.",

		// WIKI
		"wiki_tag_label": "Tags",
		"wiki_name_label": "Name",
		"wiki_cost_label": "Cost",
		"wiki_description_label": "Description",
		"wiki_title": "Glyphica Official Wiki",
		"wiki_subtitle": "Official Wiki of Glyphica Typing Survival",
		"wiki_home_title": "Home",
		"wiki_landingPage_title": "Welcome Typist",
		"wiki_landingPage_intro": "Welcome to the official wiki for Glyphica: Typing Survival! Test your typing skills in this horde survival game where speed and accuracy are your ultimate weapons. Equip powerful tools that transform your typing prowess into devastating attacks against relentless foes. Discover more and grab the game on Steam: [Glyphica: Typing Survival](https://store.steampowered.com/app/2400160/Glyphica_Typing_Survival/).",
		"wiki_landingPage_intro2": "This wiki serves as a comprehensive guide to the features, mechanics, and content available in the Early Access version of Glyphica. Our goal is to keep the information up-to-date as we progress toward the full release, version 1.0. The wiki is organized into sections listed in the table of contents and will be updated regularly as the game evolves.",
		"wiki_tableOfContents_title": "Table of Contents",
		"wiki_mainWeapons_title": "Main Weapons",
		"wiki_mainWeapons_intro": "Main weapons are the starting weapons in *Glyphica* and play a central role in gameplay. When you type a word displayed above an enemy, the main weapon locks onto that enemy as its target. Each main weapon has unique effects and mechanics, requiring different strategies to use effectively.",
		"wiki_mainWeapons_intro2": "While some main weapons emphasize typing speed (WPM), others demand a more tactical approach. Like other weapons in the game, main weapons can be upgraded and evolved, enhancing their abilities and effectiveness as you progress.",
		"wiki_mainWeapons_list_title": "List of Main Weapons",
		"wiki_weapons_title": "Level-Up Weapons",
		"wiki_weapons_intro": "Level-up weapons are obtained during a run as you level up. Once selected, the weapon is added to your arsenal. Each weapon has a unique activation method, but most can be triggered through typing and targeting with the main weapon.",
		"wiki_weapons_intro2": "A maximum of four weapons can be obtained this way. Once a weapon is added to your arsenal, its upgrades become available in the level-up upgrade pool, allowing you to enhance its abilities as you progress.",
		"wiki_weapons_list_title": "List of Level-Up Weapons",
		"wiki_weapon_evolution_title": "Evolutions",
		"wiki_weapon_upgrade_title": "Upgrades",
		"wiki_lootItems_title": "Loot Items",
		"wiki_lootItems_intro": "Loot items are obtained during a run by activating a treasure chest pickup. A randomized selection of loot items will be displayed, and choosing one grants a passive bonus that remains active for the rest of the run.",
		"wiki_lootItems_intro2": "Loot items are categorized as **common**, **uncommon**, and **rare**, which determine their likelihood of appearing in loot selections. Defeating a boss in Trial Mode rewards a treasure chest containing only rare items.",
		"wiki_lootItems_rare_title": "List of Rare Loot",
		"wiki_lootItems_uncommon_title": "List of Uncommon Loot",
		"wiki_lootItems_common_title": "List of Common Loot",
		"wiki_enemies_title": "Enemies",
		"wiki_enemies_intro": "Enemies in *Glyphica* are procedurally spawned based on an internal metric called **threat**, which increases as the run progresses. In Trial Mode, the threat is multiplied by the current Trial Level, making each level progressively harder. In Endless Mode, the threat is compared to an adaptive scaling system based on the player's level, with the higher value determining the spawn difficulty.",
		"wiki_enemies_intro2": "Enemies are also categorized into **specials** and **elites**, each with its own class cap that limits their spawn rate within the overall threat level.",
		"wiki_enemies_list_title": "List of Enemies",
		"wiki_enemy_variants_title": "List of Variants",
		"wiki_image_label": "Image",
		"wiki_splitter_shard_count": "Shard Count",
		"wiki_splitter_shard_health": "Shard Health",
		"wiki_splitter_shard_damage": "Shard Damage",
		"wiki_augments_title": "Augments",
		"wiki_augments_intro": "Augments are permanent upgrades that can be unlocked using Coins (§), a currency earned during a run. At the start of each run, players have a limited number of slots to equip unlocked augments, with the number of available slots varying based on the selected Omen level.",
		"wiki_augments_intro2": "Each augment usually has specific conditions that determine its benefits. To get the most out of your augments, consider the synergies between them and align them with your preferred strategy."
	}
}