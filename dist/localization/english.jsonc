		// Main Weapon unlock requirements.
		"weapon_heatray_requirements": "Complete Repeater Trials on any Omen level.",
		"weapon_barrage_requirements": "Complete Trials on Omen Level 3 with any main weapon.",

		// Weapon Description.
		"weapon_repeater_desc": "Devastating weapon that fires a number of bullets in short bursts.",
		"weapon_heatray_desc": "Fires a constant beam of incredibly accurate concentrated light that does damage over time.",
		"weapon_barrage_desc": "Fires a volley of explosive rockets at a target and its surroundings. Recharges over time.",
		"weapon_overmind_desc": "Command an assortment of drones to rain devastation on your foes.",
		"weapon_splattershot_desc": "Fire globs of goo at your opponents to cripple and damage them.",
		"weapon_wildcard_desc": "Your next shot is randomly selected from four possible weapons, so fire carefully.",
		"weapon_spectre_desc": "spawns fast melee drones equivalent to number of the above matched.",
		"weapon_sentry_desc": "Deploy an automated turret that fires at any enemy that comes within range.",
		"weapon_tesla_desc": "deploys an electrical turret that deals damage over time.",
		"weapon_oscillator_desc": "Fire an oscillating stream of particles in the direction of your most recent target.",
		"weapon_meteor_desc": "Periodically spawns target markers in random locations that can be activated to start an orbital bombardment.",
		"weapon_hunter_desc": "spawns electrical beam firing drones equivalent to number of the above matched.",
		"weapon_chopper_desc_v2": "Spawns a massive spinning blade on main weapon fire that travels to the screen edge, damaging all enemies in its path.",
		"weapon_minefield_desc": "spawns slow-moving mines that explode on contact with enemies.",
		"weapon_blade_desc": "deploys a spinning four-spoked blade trap.",
		"weapon_firestorm_desc": "A cannon that fires a barrage of short-range explosive rounds. It circles the main turret and needs to cooldown before firing again.",
		"weapon_guardian_desc": "Instantly deploy a Drone that fires lasers at enemies. Activate Fuel pickups to refuel Guardian, which will consume fuel and deactivate when empty.",

		// Non-weapon damage source descriptions.
		"weapon_frostbite_desc": "Global effect - does not count as a weapon.\n\nEnemies take damage over time when Frozen.",
		"weapon_bleeding_desc": "Status effect - does not count as a weapon.\n\nEnemies take Kinetic damage over time until effect expires.",
		"weapon_blight_desc": "Status effect - does not count as a weapon.\n\nEnemies take Chemical damage over time and is slowed until effect expires.",
		"weapon_static_desc": "Status effect - does not count as a weapon.\n\nEnemies take Energy damage over time, and deals Energy damage to nearby enemies until effect expires.",
		"weapon_ignite_desc": "Status effect - does not count as a weapon.\n\nEnemies take Heat damage over time until effect expires.",

		// Weapon Description Headers.
		"contains_characters": "Completing words containing the glyphs",
		"contains_glyphs": "Completing sets containing the glyphs",
		"starts_with_character": "Completing words starting with glyphs",
